# Server-only Supabase settings, read exclusively by the BFF in app/api/*.
# Do NOT prefix these with NEXT_PUBLIC_; they must never reach the client bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key


# Optional: public site address used in magic-link emails (set this in production,
# e.g. https://ryannpace.pages.dev). Defaults to the address of the incoming request.
# SITE_URL=https://your-domain.example

# Optional: Cloudflare Turnstile bot check on sign-in (public site key).
# Also paste the Turnstile *secret* key into Supabase → Authentication → Attack Protection.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Cloudflare Web Analytics (public beacon token, cookie-free).
# NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Optional: public site address printed in poster QR codes (e.g. https://ryannpace.pages.dev).
# NEXT_PUBLIC_SITE_URL=

# Optional: Strava import (server-only; create an API app at https://www.strava.com/settings/api).
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Random string, at least 32 characters, used to encrypt Strava tokens in a cookie.
# STRAVA_TOKEN_SECRET=
